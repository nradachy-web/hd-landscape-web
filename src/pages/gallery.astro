---
/* Selected work. Real photographs, plus Jake's design renderings set beside the
   photo of the yard each was drawn from, labeled as designs. No relit images and no
   illustrations on this page. Nick has said no filterable catalog, square expand icons or modal
   viewer, so these are composed bands of captioned photos. Old address kept. */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Edge from '../components/Edge.astro';
import Head from '../components/Head.astro';
import Photo from '../components/Photo.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { photo, type PairId, type PhotoId } from '../data/photos';
import { heroImage } from '../lib/hero';
import { balance } from '../lib/paths';
import { breadcrumbs } from '../lib/schema';

const head = await heroImage('hedge-curve', { sizes: '(min-width: 60rem) 48vw, 1px' });
const path = '/gallery/';
const sets: { id: string; title: string; intro: string; photos: PhotoId[] }[] = [
  { id: 'beds', title: 'Beds and **planting.**', intro: 'New beds, clean lines and plants set where they will do well.', photos: ['curve-brick-bed', 'urn-bed', 'colonial-dogwood', 'tudor-planting', 'patio-bed', 'hosta-bed', 'evergreen-island', 'maple-rock-bed', 'thrift-boulder', 'island-bed'] },
  { id: 'stone', title: 'Stone, walls and **walks.**', intro: 'Block borders, river rock, black stone and walks that hold their line.', photos: ['curved-walk', 'flagstone-walk', 'weeping-border', 'ranch-stone-bed', 'paver-walk', 'rock-bed-hydrangea', 'slate-sidewalk', 'black-stone-kidney', 'limestone-bed', 'flagstone-side', 'river-rock-beds'] },
  { id: 'hedges', title: 'Hedges **by hand and eye.**', intro: 'Long runs, tight curves and the odd topiary.', photos: ['stone-manor', 'hedge-long', 'tall-hedge', 'arborvitae-bed', 'hedge-walk', 'pool-hedge', 'topiary-spiral', 'boxwood-front'] },
  { id: 'lawns', title: 'Lawns, sod and **grading.**', intro: 'Graded first, then laid in tight seams, right up to the edge.', photos: ['sod-backyard', 'sod-colonial', 'sod-circle', 'grade-rake', 'steppers-lawn', 'shade-lawn'] },
  { id: 'commercial', title: 'Commercial **properties.**', intro: 'Entries, planters and foundation beds for businesses.', photos: ['commercial-palms', 'commercial-entry', 'condo-evergreens'] },
];
---

<Base
  title="Our Work: Real Landscaping Projects | HD Landscape"
  description="Real photos of HD Landscape jobs across Metro Detroit: beds, stone, hedges, sod and commercial properties, plus before and after comparisons."
  path={path}
  preload={{ ...head.preload, media: '(min-width: 60rem)' }}
  schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Our work', path }])]}
>
  <PageHead image={head} eyebrow="Our work" title="Real jobs, **real phone photos.**" lede="Every photo on this page is one of our jobs. No stock photos and nothing staged, and the design renderings are labeled as designs." crumbs={[{ name: 'Our work', path }]} next="ink" />

  <section class="band ink has-edge" aria-labelledby="ba-h">
    <div class="wrap">
      <Head id="ba-h" eyebrow="Before and design" title="Planned **before we dig.**" intro="Each design starts from a photo of the real yard. Drag the line to compare the yard with the plan." />
      <div class="ba-row ba-row--wide">
        {['ba-manor', 'ba-colonial', 'ba-craftsman', 'ba-border', 'ba-willow', 'ba-planter', 'ba-terrace', 'ba-patio'].map((p) => <BeforeAfter pair={p as PairId} sizes="(min-width: 48rem) 46vw, 92vw" />)}
      </div>
      <div class="ba-more">
        <Head id="ba-real-h" layout="left" small eyebrow="Before and after" title="Real jobs, filmed by Jake." />
        <div class="ba-row">
          <BeforeAfter pair="ba-corner" />
          <BeforeAfter pair="ba-hedge" />
          <BeforeAfter pair="ba-side" />
        </div>
      </div>
    </div>
    <Edge to="paper" />
  </section>

  {
    sets.map((s, i) => (
      <section class:list={['band', i % 2 === 1 && 'white']} aria-labelledby={`set-${s.id}`}>
        <div class="wrap">
          <Head id={`set-${s.id}`} title={s.title} intro={s.intro} />
          <div class="set">
            {balance(s.photos, (id) => photo(id).src.height / photo(id).src.width, 3).map((col) => (
              <ul>
                {col.map((id) => (
                  <li>
                    <figure>
                      <div class="frame"><Photo id={id} widths={[420, 640, 900]} sizes="(min-width: 60rem) 31vw, 46vw" /></div>
                      <figcaption class="note cap">{photo(id).caption}</figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <QuoteBand title="Want your yard on this page?" />
</Base>

<style>
  .ba-row {
    display: grid;
    gap: 2rem;
  }

  .ba-more {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line-ink);
  }

  @media (min-width: 48rem) {
    .ba-row--wide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.25rem 1.75rem;
    }
  }

  @media (min-width: 56rem) {
    .ba-row:not(.ba-row--wide) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  /* three even columns, balanced at build time, so no set ends in a hole */
  .set {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: start;
  }

  .set ul {
    display: grid;
    gap: 0.9rem;
  }

  .set ul:last-child:not(:first-child) {
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 60rem) {
    .set {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .set ul {
      gap: 1.25rem;
    }

    .set ul:last-child:not(:first-child) {
      grid-column: auto;
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
