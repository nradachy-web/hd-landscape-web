---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { BRAND } from '../data/site';
import { GROUPS } from '../data/services';
import { href } from '../lib/paths';
---

<Base title={`Page not found | ${BRAND.name}`} description={`That page is not here. Find landscape design, sod, hedge trimming and care from ${BRAND.name} in ${BRAND.city}, MI.`} path="/404/" quoteHref="/get-an-estimate/" noindex bare>
  <PageHead eyebrow="Page not found" title="That page has been **dug up.**" lede="The link may be old, or the page may have moved when we rebuilt the site. These will get you where you were going." next="ink">
    <ul class="chips" data-not-found>
      <li><a class="chip" href={href('/services/')}>All services</a></li>
      <li><a class="chip" href={href('/service-areas/')}>Service areas</a></li>
      <li><a class="chip" href={href('/gallery/')}>Our work</a></li>
      <li><a class="chip" href={href('/contact-us/')}>Contact</a></li>
    </ul>
    <div class="actions">
      <a class="btn primary" href={href('/')}>Go to the home page</a>
      <a class="btn ghost" href={BRAND.phoneHref} data-loc="404">Call {BRAND.phone}</a>
    </div>
  </PageHead>
</Base>
