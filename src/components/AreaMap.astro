---
/* Where HD Landscape works, on a real map: Lake St. Clair, the Detroit River and
   Woodward Avenue drawn from coordinates, and every town a lit point that links
   to its page. It reads like the towns at dusk from the air. The text list of
   towns stays on the page beside it for search engines and screen readers. */
import { CITIES, hubPath, type City } from '../data/cities';
import { href } from '../lib/paths';

const POS: Record<string, [number, number]> = {
  'st-clair-shores': [42.497, -82.889], 'grosse-pointe': [42.386, -82.912], 'grosse-pointe-park': [42.376, -82.937], 'grosse-pointe-farms': [42.407, -82.892],
  'grosse-pointe-woods': [42.444, -82.907], 'grosse-pointe-shores': [42.437, -82.877], birmingham: [42.547, -83.211],
  'bloomfield-hills': [42.584, -83.246], 'bloomfield-township': [42.578, -83.283], 'beverly-hills': [42.524, -83.223], franklin: [42.522, -83.306],
  'west-bloomfield': [42.569, -83.383], 'royal-oak': [42.49, -83.145], 'huntington-woods': [42.481, -83.167], troy: [42.606, -83.15], rochester: [42.681, -83.134],
  'rochester-hills': [42.658, -83.15], 'oakland-township': [42.742, -83.128], 'lake-orion': [42.784, -83.239], 'clinton-township': [42.587, -82.92], 'harrison-township': [42.584, -82.821],
  'macomb-township': [42.663, -82.919], 'shelby-township': [42.671, -83.033], 'sterling-heights': [42.58, -83.03], 'washington-township': [42.773, -83.035],
  warren: [42.515, -83.015], fraser: [42.539, -82.949], 'mount-clemens': [42.597, -82.878],
  'chesterfield-township': [42.68, -82.838], 'new-baltimore': [42.681, -82.737],
};
/* the few that stay labeled on a phone */
const PHONE = ['st-clair-shores', 'grosse-pointe', 'birmingham', 'troy', 'new-baltimore'];
const LABEL = ['st-clair-shores', 'grosse-pointe', 'birmingham', 'troy', 'rochester-hills', 'royal-oak', 'warren', 'sterling-heights', 'clinton-township', 'bloomfield-hills', 'west-bloomfield', 'shelby-township', 'new-baltimore', 'macomb-township', 'harrison-township'];

const W = 960, H = 724;
const LAT0 = 42.8, LON0 = -83.43, SX = 960 / 0.8, SY = SX * 1.35;
const xy = (lat: number, lon: number): [number, number] => [Math.round((lon - LON0) * SX), Math.round((LAT0 - lat) * SY)];
const path = (pts: [number, number][]) => pts.map(([a, b], i) => `${i ? 'L' : 'M'}${xy(a, b).join(' ')}`).join('');

/* the lake, from the Detroit River up the shore to Anchor Bay */
const SHORE: [number, number][] = [[42.33, -82.99], [42.345, -82.955], [42.36, -82.93], [42.375, -82.905], [42.392, -82.882], [42.415, -82.872], [42.44, -82.868], [42.465, -82.872], [42.49, -82.872], [42.515, -82.868], [42.54, -82.855], [42.56, -82.84], [42.578, -82.805], [42.6, -82.79], [42.625, -82.8], [42.645, -82.79], [42.665, -82.765], [42.68, -82.735], [42.69, -82.71], [42.69, -82.6], [42.6, -82.6], [42.33, -82.6]];
const lake = `${path(SHORE)}Z`;
const river = path([[42.33, -83.0], [42.31, -83.09], [42.28, -83.12]]);
const woodward = path([[42.33, -83.05], [42.4, -83.1], [42.47, -83.14], [42.53, -83.2], [42.58, -83.245], [42.635, -83.285]]);
const towns = CITIES.filter((c): c is City => c.state === 'MI' && !!POS[c.id]).map((c) => {
  const [x, y] = xy(POS[c.id][0], POS[c.id][1]);
  return { c, x, y, on: LABEL.includes(c.id), phone: PHONE.includes(c.id), down: c.id === 'clinton-township', end: c.id === 'new-baltimore' };
});
---

<figure class="am">
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Map of the towns HD Landscape serves, from Lake St. Clair to Woodward Avenue">
    <defs>
      <radialGradient id="am-g"><stop offset="0" stop-color="#f2c56e" stop-opacity="0.95" /><stop offset="0.35" stop-color="#f2b552" stop-opacity="0.28" /><stop offset="1" stop-color="#f2b552" stop-opacity="0" /></radialGradient>
    </defs>
    <path class="am__lake" d={lake} />
    <path class="am__river" d={river} />
    <path class="am__road" d={woodward} />
    <text class="am__tag" x="944" y="430" text-anchor="end">Lake St. Clair</text>
    <text class="am__tag am__tag--w" x="176" y="498" transform="rotate(-49 176 498)">Woodward Ave</text>
    {
      towns.map((t) => (
        <a href={href(hubPath(t.c))} class="am__t" aria-label={t.c.name}>
          <circle class="am__hit" cx={t.x} cy={t.y} r="20" />
          <circle class="am__glow" cx={t.x} cy={t.y} r="18" fill="url(#am-g)" />
          <circle class="am__dot" cx={t.x} cy={t.y} r="4" />
          <text class:list={['am__n', !t.on && 'am__n--hover', !t.phone && 'am__n--wide']} text-anchor={t.end ? 'end' : undefined} x={t.end ? t.x - 12 : t.down ? t.x - 6 : t.x + 10} y={t.down ? t.y + 26 : t.y + 5}>{t.c.name}</text>
        </a>
      ))
    }
  </svg>
  <figcaption class="note cap">Each light is a town we work in. Pick one to see that page, or use the list below.</figcaption>
</figure>

<style>
  .am svg {
    width: 100%;
    height: auto;
    border: 1px solid var(--line-ink);
    border-radius: var(--r);
    background: var(--ink-2);
  }

  .am__lake {
    fill: #142033;
    stroke: rgb(236 244 228 / 0.28);
    stroke-width: 1.2;
  }

  .am__river {
    fill: none;
    stroke: #22344f;
    stroke-width: 7;
    stroke-linecap: round;
  }

  .am__road {
    fill: none;
    stroke: rgb(188 220 108 / 0.42);
    stroke-width: 1.5;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }

  .am__tag {
    fill: #7c93b5;
    font: italic 400 19px var(--font-display);
    letter-spacing: 0.02em;
  }

  .am__tag--w {
    fill: rgb(188 220 108 / 0.72);
    font-size: 15px;
  }

  .am__hit {
    fill: transparent;
  }

  .am__dot {
    fill: #fbe3a8;
    transition: r 0.15s var(--ease);
  }

  .am__n {
    fill: var(--on-ink);
    font: 540 14px var(--font);
    paint-order: stroke;
    stroke: var(--ink-2);
    stroke-width: 3.5px;
  }

  .am__n--hover {
    opacity: 0;
    transition: opacity 0.15s var(--ease);
  }

  .am__t:hover .am__n--hover,
  .am__t:focus-visible .am__n--hover {
    opacity: 1;
  }

  .am__t:hover .am__dot,
  .am__t:focus-visible .am__dot {
    fill: var(--leaf);
  }

  .am__t:hover .am__n,
  .am__t:focus-visible .am__n {
    fill: var(--leaf);
  }

  @media (max-width: 39.99rem) {
    .am__n {
      font-size: 34px;
      stroke-width: 7px;
    }

    .am__n--wide {
      display: none;
    }

    .am__dot {
      r: 9px;
    }

    .am__hit {
      r: 30px;
    }

    .am__glow {
      r: 30px;
    }

    .am__tag {
      font-size: 30px;
    }

    .am__tag--w {
      display: none;
    }
  }
</style>
