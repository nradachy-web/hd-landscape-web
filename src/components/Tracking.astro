---
/* Google Analytics, on the production domain only. The tag library is big, so it
   waits for the visitor's first touch, scroll or key press, or a visit with an ad
   click ID, and events before that are queued. That is what keeps the pages at
   100 on PageSpeed. His GA4 property is kept so his history carries over.

   The click ID and UTM tags are kept for 90 days and handed to the estimate form,
   so a lead can be traced to the ad that brought it.

   Events, for GA4 key events and Google Ads imports:
     generate_lead     a sent estimate request, counted once on the thank-you page
                       (lead_source estimate_form or yard_studio, services, town, form_page)
     phone_tap         a tap on any call link (location says which one)
     text_tap          a tap on any text link
     email_tap         a tap on the email address
     estimate_start    the first touch on an estimate form, once per page
     estimate_step     step 2 of the form reached
     estimate_error    a send that did not go through
     studio_send       a Yard Studio design put into the estimate form
     studio_link       a Yard Studio design link copied
     social_click      Instagram, Facebook or TikTok
     page_not_found    the 404 page, with the address that was asked for
   Other scripts call window.hdTrack(name, params). No names, phone numbers or
   emails are ever sent to Google. */
import { TRACKING } from '../data/site';
---

<script is:inline define:vars={{ T: TRACKING }}>
  (function () {
    var w = window, KEYS = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'], fromAd = false;
    try {
      var q = new URLSearchParams(location.search), m = document.cookie.match(/(?:^|;\s*)hd_src=([^;]+)/), kept = m ? JSON.parse(decodeURIComponent(m[1])) || {} : {}, fresh = false;
      KEYS.forEach(function (k) { var v = q.get(k); if (v) { kept[k] = v.slice(0, 200); fresh = true; if (k.length === 5 || k.length === 6) fromAd = true; } });
      if (fresh) document.cookie = 'hd_src=' + encodeURIComponent(JSON.stringify(kept)) + ';path=/;max-age=7776000;samesite=lax' + (location.protocol === 'https:' ? ';secure' : '');
    } catch (e) {}
    var live = location.hostname.replace(/^www\./, '') === T.host;
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () { dataLayer.push(arguments); };
    function ev(name, params) { if (live) gtag('event', name, params || {}); }
    w.hdTrack = ev;

    var SOCIAL = /instagram\.com|facebook\.com|tiktok\.com/;
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a) return;
      var h = a.getAttribute('href'), where = { location: a.dataset.loc || '' };
      if (h.indexOf('tel:') === 0) ev('phone_tap', where);
      else if (h.indexOf('sms:') === 0) ev('text_tap', where);
      else if (h.indexOf('mailto:') === 0) ev('email_tap', where);
      else if (SOCIAL.test(h)) ev('social_click', { network: (SOCIAL.exec(h) || [''])[0].split('.')[0] });
    });
    if (!live) return;
    gtag('js', new Date());
    gtag('config', T.ga4);

    var lead = document.documentElement.hasAttribute('data-lead');
    if (lead) {
      /* The form leaves a note just before it sends the visitor here, so a reload or
         a bookmarked thank-you page is not counted twice. A send without script
         comes back from Web3Forms with no note, and still counts once. */
      var note = null;
      try { note = JSON.parse(sessionStorage.getItem('hd_lead') || 'null'); sessionStorage.removeItem('hd_lead'); } catch (e) {}
      if (note) ev('generate_lead', note);
      else if (/web3forms/.test(document.referrer)) ev('generate_lead', { lead_source: 'estimate_form', method: 'no_script' });
    }
    var missing = !!document.querySelector('[data-not-found]');
    if (missing) ev('page_not_found', { missing_path: location.pathname, came_from: document.referrer || 'direct' });

    var done = false, wake = ['pointerdown', 'touchstart', 'keydown', 'scroll'];
    function load() {
      if (done) return;
      done = true;
      wake.forEach(function (n) { removeEventListener(n, load); });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + T.ga4;
      document.head.appendChild(s);
    }
    if (fromAd || lead || missing) load();
    else wake.forEach(function (n) { addEventListener(n, load, { passive: true }); });
  })();
</script>
