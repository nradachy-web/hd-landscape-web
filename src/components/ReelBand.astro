---
/* Three short clips from Jake's own reels: the one place the site moves on its
   own below the hero. Real footage, muted, slowed a touch. Each file is under
   half a megabyte, none loads until the band is close, and they play only while
   on screen. Reduced motion or data saving keeps the still frames.

   The still frame is a lazy image under the video, not a poster attribute: a
   browser fetches posters immediately, which cost the hero 7 points on a phone. */
import { href } from '../lib/paths';

const clips = [
  { src: '/video/reel-flagstone', cap: 'Boxwood and hydrangeas along a flagstone walk', w: 540, h: 960 },
  { src: '/video/reel-walk', cap: 'River rock and clipped shrubs at a front walk', w: 540, h: 960 },
  { src: '/video/reel-deck', cap: 'A new bed under a deck', w: 540, h: 960 },
];
---

<button class="btn ghost small rb__stop" type="button" aria-pressed="false" hidden data-reels-stop>Pause clips</button>
<div class="rb" data-reels tabindex="0" role="region" aria-label="Clips from finished yards. Scroll sideways for more.">
  {
    clips.map((c) => (
      <figure>
        <div class="rb__f">
          <img src={href(`${c.src}.jpg`)} width={c.w} height={c.h} alt={c.cap} loading="lazy" decoding="async" />
          <video muted loop playsinline preload="none" width={c.w} height={c.h} aria-hidden="true" tabindex="-1" data-src={href(`${c.src}.mp4`)}></video>
        </div>
        <figcaption class="note cap">{c.cap}</figcaption>
      </figure>
    ))
  }
</div>

<script is:inline>
  (function () {
    var box = document.querySelector('[data-reels]');
    if (!box || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (navigator.connection && navigator.connection.saveData) return;
    var stop = document.querySelector('[data-reels-stop]'), held = false, list = box.querySelectorAll('video');
    stop.hidden = false;
    stop.addEventListener('click', function () {
      held = !held;
      stop.setAttribute('aria-pressed', String(held));
      stop.textContent = held ? 'Play clips' : 'Pause clips';
      list.forEach(function (v) { if (held) v.pause(); else if (v.src) v.play().catch(function () {}); });
    });
    list.forEach(function (v) {
      new IntersectionObserver(function (es) {
        if (held) return;
        if (es[0].isIntersecting) {
          if (!v.src) { v.src = v.dataset.src; v.addEventListener('playing', function () { v.classList.add('is-on'); }, { once: true }); }
          v.play().catch(function () {});
        } else if (v.src) v.pause();
      }, { rootMargin: '200px 0px' }).observe(v);
    });
  })();
</script>

<style>
  .rb__stop {
    margin-bottom: 1rem;
  }

  .rb {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 20rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .rb::-webkit-scrollbar {
    display: none;
  }

  .rb figure {
    scroll-snap-align: center;
  }

  .rb__f {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    border-radius: var(--r);
    background: var(--ink-3);
  }

  .rb__f img,
  .rb__f video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rb__f video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .rb__f video.is-on {
    opacity: 1;
  }

  @media (min-width: 56rem) {
    .rb {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .rb__f {
      aspect-ratio: 4 / 5;
    }
  }
</style>
