---
/* One full bleed photo, edge to edge, to break up a long page. The cut bed line
   sits on it top and bottom. Lazy, and captioned honestly like every picture. */
import Photo from './Photo.astro';
import Edge from './Edge.astro';
import { photo, type PhotoId } from '../data/photos';

interface Props {
  id: PhotoId;
  /** The planes above and below. */
  from?: 'paper' | 'white' | 'ink';
  to?: 'paper' | 'white' | 'ink';
}
const { id, from = 'paper', to = 'paper' } = Astro.props;
const p = photo(id);
---

<figure class="pb" aria-label={p.alt}>
  <Photo id={id} ratio={2.2} widths={[828, 1280, 1672, 2000]} sizes="100vw" focus="center" alt={p.alt} />
  <Edge to={from} top />
  <figcaption class="note pb__cap">{p.caption}</figcaption>
  <Edge to={to} flip />
</figure>

<style>
  .pb {
    position: relative;
    overflow: hidden;
    background: var(--ink);
  }

  .pb :global(img) {
    width: 100%;
    height: clamp(16rem, 40vw, 36rem);
    object-fit: cover;
  }

  .pb__cap {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2.2rem, 5vw, 4.6rem);
    z-index: 4;
    padding: 0.15rem 0.45rem;
    border-radius: var(--r-sm);
    background: rgb(10 15 11 / 0.62);
    color: var(--on-ink);
  }
</style>
